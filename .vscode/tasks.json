{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/LanguageApp.Api/LanguageApp.Dotnet.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "npm-install-webapp",
      "command": "npm",
      "type": "shell",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}/LanguageApp.WebApp" },
      "problemMatcher": []
    }
  ]
}
